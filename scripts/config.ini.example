; Session Pro Backend configuration.
;
; deploy.sh installs this to /etc/session-pro-backend/config.ini (only if not already
; present, so your edits are never clobbered) and rewrites the `db_url` line to point at
; the dedicated PostgreSQL cluster it created (peer auth over the unix socket, so there is
; no password to store here).
;
; After the first deploy, edit this file to fill in the [apple] / [google] credentials (or
; leave the platforms disabled), then: systemctl restart pro-backend

[base]
; Set automatically by deploy.sh to the dedicated cluster's socket + auto-assigned port,
; e.g. postgresql:///session_pro?host=/var/run/postgresql&port=5433&user=pro-backend
db_url                 =

; Ed25519 proof-signing key, loaded from this file (128 hex chars = the libsodium secret key:
; 32-byte seed + 32-byte public key). It is NEVER stored in the database. deploy.sh installs a key
; you provide via BACKEND_KEY_SRC (generate one with `session-router-config -k <file>`); it never
; generates a key itself. Back this file up SEPARATELY and securely — it is NOT covered by the
; database backups. Tests/dev supply an ephemeral key via this same path.
backend_key_path       = /etc/session-pro-backend/key_ed25519

unsafe_logging         = false

; provider_dry_run=true stubs ALL payment-provider egress (Apple/Google): outbound mutations become
; no-ops and gating reads return synthetic success, so payments can be exercised with no provider
; credentials and no calls off-box. For local/integration testing ONLY — never enable on a real instance.
provider_dry_run       = false

; Which stores this instance ingests payments from. Each requires its matching section below to be filled
; in ([apple] / [google]); startup fails if one is enabled without its credentials. Both off is a valid
; instance -- it serves proofs for entitlements already on record and mints nothing new.
with_provider_app_store    = false
with_provider_google_play  = false

; voucher_processing_window: how old an account's voucher checkpoint must be, in SECONDS, before the
; maintenance mule charges it again. Defaults to 86400 (24h). It does not change how much is charged --
; that is always the span since the checkpoint, whenever the pass runs -- only how promptly a spent
; voucher stops entitling the account, and how the write load is spread across the day. Shorten it to
; exercise vouchers in a test deployment.
; voucher_processing_window = 86400

; renewal_latency_allowance: how long a RENEWING subscription keeps being honoured past its paid-through
; instant, in SECONDS, while we wait to learn whether it renewed. Defaults to 3600 (1h). This is OURS, not
; a store's grace period -- it absorbs the delay between a renewal landing at the store and the store's
; notification reaching us, so a subscriber does not see Pro flicker off and on across the boundary. Raise
; it ahead of planned maintenance so a backlog of notifications costs latency rather than entitlement; it
; applies immediately on reload, including to subscriptions bought before the change. Capped at 604800 (7
; days), because it extends every renewing subscriber's entitlement and a units slip would be expensive.
; renewal_latency_allowance = 3600

; max_proofs_per_window: how many Pro proofs ONE account may be issued per 7-day window. Defaults to 0,
; meaning unlimited -- the backend still counts every issue either way, so the numbers are there to look at
; before a limit is chosen. A legitimate account re-fetches on its own renewal timer (about an hour before
; a ~30-day proof expiry) times its device count, so its weekly count is a handful; a master seed extracted
; into a modified client and handed around is what makes this large, because a proof is a bearer credential
; and nothing downstream can tell a subscriber's from a copy. Set it well above real traffic before turning
; it on -- past the limit an account is refused with `rate_limited` until its window rolls, and each breach
; logs a WARNING naming the account. Refused requests are not counted, so a lapsed account cannot consume
; another's headroom.
; max_proofs_per_window = 0

; Optional outbound notification webhooks; add [session_webhook.1], etc. as needed.
; [session_webhook.0]
; enabled = true
; name    = ops
; url     = https://hooks.example.org/...

[logging]

; level: the level every logger gets unless named individually below. One of DEBUG, INFO, WARNING, ERROR
; or CRITICAL, case-insensitive. Defaults to INFO.
;
; INFO is the "what is this backend doing" tier: one line per payment action -- a purchase registered, a
; renewal, a cancellation, entering or leaving a grace period. Useful while bringing a deployment up or
; chasing a report about a specific subscriber; noisy at steady state, so production usually wants WARNING.
;
; DEBUG adds the steps WITHIN each of those actions, including a line per provider notification. It is for
; working out why something did what it did, not for leaving on.
;
; WARNING and above are always worth reading and are never routine: a failing acknowledgement, a purchase
; that could not be attributed, a reconcile that has given up (see docs/limitations.md for what each means).
; level = info

; level-<logger>: override the level for one logger, by the name that appears in the log line. The
; application's own are `pro`, `backend`, `google_play` and `app_store` -- they match the module each comes
; from, and deliberately do NOT shadow a library namespace (a logger named `google` would be the PARENT of
; every `google.*` logger the Play and Pub/Sub libraries use, and turning ours up would turn all of theirs
; up with it). Any other name reaches a third-party logger, so `level-werkzeug = error` quietens Flask's
; request log, and `level-google.api_core = warning` quietens Pub/Sub's half-hourly stream reconnects.
;
; The common shape while debugging one provider:
;   level = warning
;   level-google_play = debug
; level-app_store = info

; path: file for the app's own logging, used ONLY for non-uWSGI/CLI invocations. Under uWSGI
; (the normal deployment) it is IGNORED — the vassal's `logto` captures stdout/stderr to the log
; file and rotates it, which also avoids two processes writing/rotating the same file unsafely.
path = /var/log/pro-backend/backend.log


[apple]
; App Store Connect > Users and Access > Integrations > In-App Purchase keys.
app_id                 =
bundle_id              =
issuer_id              =
key_id                 =
; Absolute paths; store secrets under /etc/session-pro-backend/keys (0600, owned pro-backend).
key_path               =
; Apple root certificates (deploy.sh downloads these into keys/ when Apple is enabled).
root_cert_path         = /etc/session-pro-backend/keys/AppleIncRootCertificate.cer
root_cert_ca_g2_path   = /etc/session-pro-backend/keys/AppleRootCA-G2.cer
root_cert_ca_g3_path   = /etc/session-pro-backend/keys/AppleRootCA-G3.cer
sandbox_env            = true

[google]
; Google Cloud service-account JSON authorised to the Pub/Sub subscription.
cloud_app_credentials_path =
cloud_project_id           =
cloud_subscription_name    =
package_name               =
subscription_product_id    =
